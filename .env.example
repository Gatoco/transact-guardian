# Flask API
FLASK_APP=src.api.app
FLASK_ENV=production
# Generate your own key: python scripts/generate_api_key.py
API_KEY=fk_your_api_key_here

# Database
DATABASE_URL=postgresql://${POSTGRES_USER:-change_me}:${POSTGRES_PASSWORD:-change_me}@postgres:5432/fraud_detection
DB_HOST=postgres
DB_PORT=5432
DB_NAME=fraud_detection
DB_USER=change_me
DB_PASSWORD=change_me

# MLflow
MLFLOW_TRACKING_URI=postgresql://${POSTGRES_USER:-change_me}:${POSTGRES_PASSWORD:-change_me}@postgres:5432/mlflow_db
MLFLOW_EXPERIMENT_NAME=fraud_detection

# Model
MODEL_PATH=/app/models/fraud_detection_model.pkl
MODEL_THRESHOLD=0.4358
MODEL_VERSION=1.0.0
